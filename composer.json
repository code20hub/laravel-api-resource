{
    "name": "code20/laravel-api-resource",
    "description": "Scaffold a full API layer (Form Request, API Resource, Service, Controller, and optional Policy/DTO/Exception/Pest tests) for Laravel with a single artisan command.",
    "keywords": ["laravel", "api", "scaffold", "generator", "artisan", "boilerplate"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Johannes Ramothale",
            "email": "johannes@code20.co.za"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Code20\\ApiBoilerplate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Code20\\ApiBoilerplate\\ApiBoilerplateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
