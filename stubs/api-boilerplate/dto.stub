<?php

namespace {{namespace}};

/**
 * Typed data carrier for {{modelClass}} create/update operations.
 *
 * TODO: replace the generic $attributes bag below with explicit typed
 * properties once your {{modelClass}} fields are finalized, e.g.:
 *
 *     public function __construct(
 *         public readonly string $title,
 *         public readonly string $content,
 *     ) {}
 */
class {{modelClass}}Data
{
    /**
     * @param array<string, mixed> $attributes
     */
    public function __construct(
        public readonly array $attributes
    ) {}

    public static function fromArray(array $data): self
    {
        return new self($data);
    }

    public function toArray(): array
    {
        return $this->attributes;
    }

    public function get(string $key, mixed $default = null): mixed
    {
        return $this->attributes[$key] ?? $default;
    }
}
